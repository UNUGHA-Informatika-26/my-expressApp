# Salin file ini jadi .env lalu isi nilainya. Jangan pernah commit .env.

# Port server backend
PORT=3000

# Koneksi PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/my_express

# Kunci rahasia untuk tanda tangan JWT (ganti dengan string panjang acak)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d
